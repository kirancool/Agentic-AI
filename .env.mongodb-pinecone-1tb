# Atlas source
MONGODB_ATLAS_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=your_database
MONGODB_COLLECTION=your_collection
TEXT_FIELDS=text
METADATA_FIELDS=file_id,filename,page,chunk_index,created_at

# Pinecone destination: use an AWS-hosted serverless dense index.
# The index is auto-created if absent; dimension must remain 1024.
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your-index-name
PINECONE_NAMESPACE=mongodb-atlas-1tb-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_STORAGE_INTEGRATION_ID=your-pinecone-s3-integration-id

# NVIDIA embeddings (Nemotron 3.5 supports a 1024-dimension output)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_DIMENSION=1024

# S3 staging. The import prefix will contain a subfolder named after PINECONE_NAMESPACE.
S3_BUCKET=your-private-s3-bucket
S3_IMPORT_PREFIX=pinecone-import/mongodb-atlas
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Streaming/checkpoint tuning
MONGO_BATCH_SIZE=500
EMBED_BATCH_SIZE=32
PARQUET_ROWS_PER_FILE=5000
CHUNK_CHARS=5000
CHUNK_OVERLAP=300
MAX_RETRIES=8
CHECKPOINT_FILE=mongodb_pinecone_1tb_checkpoint.json
WORK_DIR=mongodb_pinecone_parquet_work
IMPORT_TIMEOUT_HOURS=72
# Stay below Pinecone's 1 TB on-demand import limit; set a lower buffer if desired.
MAX_IMPORT_GB=900
EMBED_WORKERS=4
