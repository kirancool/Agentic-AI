# Passwordless Amazon DocumentDB IAM authentication. Cluster must support IAM auth.
DOCDB_HOST=your-cluster.cluster-xxxx.us-east-1.docdb.amazonaws.com
DOCDB_PORT=27017
DOCDB_DATABASE=your_database
DOCDB_AUTH_MODE=iam
DOCDB_CA_FILE=/tmp/global-bundle.pem
AWS_REGION=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/github-docdb-migration

OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-6-astra
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET=your-migration-bucket
GCS_PREFIX=mongo-firestore/imports
FIRESTORE_DATABASE=(default)
DATAFLOW_REGION=us-central1
DATAFLOW_TEMP_GCS=gs://your-migration-bucket/dataflow-temp
DATAFLOW_STAGING_GCS=gs://your-migration-bucket/dataflow-staging
DATAFLOW_WORKER_SERVICE_ACCOUNT=dataflow-worker@your-project-id.iam.gserviceaccount.com
DATAFLOW_NUM_WORKERS=8
DATAFLOW_MAX_WORKERS=50
DATAFLOW_MACHINE_TYPE=n2-standard-4
FIRESTORE_RETRY_LIMIT=5
FIRESTORE_DEAD_LETTER_PREFIX=gs://your-migration-bucket/mongo-firestore/dead-letter
FIRESTORE_COLLECTION_PREFIX=migrated_
MONGO_EXPORT_CHUNK_MB=128
MONGO_EXPORT_BATCH_SIZE=1000
