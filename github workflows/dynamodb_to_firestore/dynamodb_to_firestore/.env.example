# AWS DynamoDB point-in-time export
AWS_REGION=us-east-1
DDB_TABLE=your-table-name
DDB_EXPORT_BUCKET=your-s3-export-bucket
DDB_EXPORT_PREFIX=dynamodb-exports
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-6-astra
AWS_TRANSFER_CREDENTIALS_FILE=aws-transfer-creds.json

# Agentic run state and Storage Transfer Service
MIGRATION_STATE_FILE=migration_state.json
TRANSFER_TIMEOUT_HOURS=48
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_TRANSFER_BUCKET=your-gcs-bucket
GCS_TRANSFER_PREFIX=dynamodb-imports

# Firestore and Dataflow
DATAFLOW_REGION=us-central1
DATAFLOW_TEMP_GCS=gs://your-gcs-bucket/dataflow-temp
DATAFLOW_STAGING_GCS=gs://your-gcs-bucket/dataflow-staging
DATAFLOW_WORKER_SERVICE_ACCOUNT=dataflow-worker@your-project-id.iam.gserviceaccount.com
DATAFLOW_NUM_WORKERS=8
DATAFLOW_MAX_WORKERS=50
DATAFLOW_MACHINE_TYPE=n2-standard-4
DATAFLOW_DISK_SIZE_GB=100
DATAFLOW_AUTOSCALING_ALGORITHM=THROUGHPUT_BASED
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=your-collection-name
DDB_DEAD_LETTER_GCS=gs://your-gcs-bucket/dynamodb-imports/dlq
FIRESTORE_RETRY_LIMIT=5
FIRESTORE_INITIAL_WRITE_RATE=50
FIRESTORE_MAX_WRITE_RATE=500

# Optional key-name overrides; defaults come from DynamoDB export metadata.
# DDB_PARTITION_KEY=your-partition-key
# DDB_SORT_KEY=your-sort-key
