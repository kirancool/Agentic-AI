# Aurora source credentials; keep passwords in GitHub Actions secrets.
AURORA_HOST=your-cluster.cluster-xxxx.us-east-1.rds.amazonaws.com
AURORA_PORT=3306
AURORA_DATABASE=your_database
AURORA_USER=migration_user
AURORA_PASSWORD=replace-me
AURORA_SSL=true
AURORA_SSL_CA=/etc/ssl/certs/aws-rds-global-bundle.pem

OPENAI_MODEL=gpt-6-astra
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET=your-migration-bucket
GCS_PREFIX=aurora-spanner/imports
SPANNER_INSTANCE_ID=your-instance
SPANNER_DATABASE_ID=your-database
SPANNER_AUTO_CREATE_SCHEMA=true
DATAFLOW_REGION=us-central1
DATAFLOW_TEMP_GCS=gs://your-migration-bucket/dataflow-temp
DATAFLOW_STAGING_GCS=gs://your-migration-bucket/dataflow-staging
DATAFLOW_WORKER_SERVICE_ACCOUNT=dataflow-worker@your-project-id.iam.gserviceaccount.com
DATAFLOW_NUM_WORKERS=8
DATAFLOW_MAX_WORKERS=50
DATAFLOW_MACHINE_TYPE=n2-standard-4
EXPORT_CHUNK_MB=128
EXPORT_BATCH_SIZE=1000
SPANNER_BATCH_ROWS=50
SPANNER_DEAD_LETTER_PREFIX=gs://your-migration-bucket/aurora-spanner/dead-letter
